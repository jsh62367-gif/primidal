-- Rapid Fire Loop
task.spawn(function()
    while isAlive() do
        local RF = Axiom['Weapon Modifiers']['Rapid Fire']
        if RF['Enabled'] and isMouseDown then
            local Tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
            if Tool then
                local allowed = true
                local cd = RF['Amount'] or 0
                if RF['Weapons'][Tool.Name] then cd = RF['Weapons'][Tool.Name] end
                
                Tool:Activate()
                
                if cd > 0 then task.wait(cd) else task.wait() end
            else
                task.wait()
            end
        else
            task.wait()
        end
    end
end)

