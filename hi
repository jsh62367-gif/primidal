        end
    else
        camLockEnabled      = false
        camLockTarget       = nil
        camLockPart         = nil
        CLFovCircle.Visible = false
    end

    -- Weapon Modifiers Loop
    local Tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if Tool then
        -- Spread Logic
        if WM['Spread']['Enabled'] then
            local mult = WM['Spread']['Amount'] or 0
            if WM['Spread']['Weapons'][Tool.Name] then mult = WM['Spread']['Weapons'][Tool.Name] end
            if game.PlaceId == 103176029075121 and mult == 0 then mult = 0.001 end
            for _, v in pairs(Tool:GetDescendants()) do
                if v:IsA("ValueBase") and (v.Name == "Spread" or v.Name == "Recoil" or v.Name == "Inaccuracy" or v.Name == "MaxSpread") then
                    v.Value = v.Value * mult
                end
            end
        end
        -- Delay Changer (ValueBase fast-path -- heavy multi-method runs on Heartbeat below)
        if WM['Delay Changer']['Enabled'] then
            local dc    = WM['Delay Changer']
            local delay = dc['Amount'] or 0
            if dc['Weapons'][Tool.Name] ~= nil then delay = dc['Weapons'][Tool.Name] end
            for _, v in pairs(Tool:GetDescendants()) do
                if v:IsA("NumberValue") or v:IsA("IntValue") then
                    if v.Name == "ShootingCooldown" or v.Name == "FireDelay"
                        or v.Name == "Cooldown" or v.Name == "FireRate" then
                        v.Value = delay
                    end
                end
            end
            if Tool:GetAttribute("ShootingCooldown") then
                Tool:SetAttribute("ShootingCooldown", delay)
            end
        end
        -- Range Logic
        if WM['Range']['Enabled'] then
            local range = WM['Range']['Amount'] or 9e9
            if WM['Range']['Weapons'][Tool.Name] then range = WM['Range']['Weapons'][Tool.Name] end
            local rangeNames = {"Range", "MaxRange", "Distance", "BulletRange", "MaxDistance"}
            for _, v in pairs(Tool:GetDescendants()) do
                if v:IsA("ValueBase") and table.find(rangeNames, v.Name) then
                    v.Value = range
                end
            end
            for _, name in pairs(rangeNames) do
                if Tool:GetAttribute(name) then
                    Tool:SetAttribute(name, range)
                end
            end
        end
    end

    if Config['Enabled'] then
        if Config['Mode'] == 'Automatic' then Target = GetClosestPlayer() end
        if Target and Target.Character then
            TargetPart = (Config['Hit Part'] == 'Closest Part') and GetClosestPart(Target.Character) or Target.Character:FindFirstChild(Config['Hit Part'])
            if clIsKnocked(Target.Character) then
                if Config['Mode'] == 'Target' then Axiom['Silent Aim']['Enabled'] = false end
                Target = nil TargetPart = nil
            end
        else Target = nil TargetPart = nil end
    else Target = nil TargetPart = nil end

    if Config['FOV']['Enabled'] then
        FOVCircle.Position = UserInputService:GetMouseLocation()
        FOVCircle.Radius = Config['FOV']['Radius']
        FOVCircle.Visible = Config['FOV']['Visible']
    else FOVCircle.Visible = Config['FOV']['Visible'] end

    for userId, lbl in pairs(espLabels) do
        if not ESP_C['Enabled'] then lbl.Visible = false continue end
        local player = nil
        for _, p in ipairs(Players:GetPlayers()) do if tostring(p.UserId) == userId then player = p break end end
        if not player or not player.Parent then pcall(function() lbl:Destroy() end) espLabels[userId] = nil continue end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root or not char:FindFirstChildOfClass("Humanoid") or char:FindFirstChildOfClass("Humanoid").Health <= 0 then lbl.Visible = false continue end
        local sp, on = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
        if not on or sp.Z <= 0 then lbl.Visible = false continue end
        local isTargeted = (Target ~= nil and Target == player)
        if userId == "10394633651" then
            lbl.Text = "ruin mogs u lmao"
            local hue = (math.sin(time * 2) + 1) / 2
            lbl.TextColor3 = Color3.fromRGB(0, 100, 255):Lerp(Color3.fromRGB(100, 200, 255), hue)
        elseif userId == "6104327762" then
