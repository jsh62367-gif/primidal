-- ============================================================
--  RE-EXECUTE GUARD
--  Lives here in the logic section, below the config table.
--  On re-execute: kills old loops, cleans up all GUIs/drawings/
--  hooks, waits 3 seconds, then continues fresh.
-- ============================================================

-- Signal any previous instance to stop
if shared._AxiomRunning then
    shared._AxiomRunning = false
    task.wait(3)
end
shared._AxiomRunning = true

-- Run cleanup functions registered by the previous execution
if shared._AxiomCleanup then
    for _, fn in ipairs(shared._AxiomCleanup) do
        pcall(fn)
    end
end
shared._AxiomCleanup = {}

-- Register a function to run when this instance is cleaned up on next re-execute
local function onCleanup(fn)
    table.insert(shared._AxiomCleanup, fn)
end

-- Returns false the moment a new execution signals this one to stop
local function isAlive()
    return shared._AxiomRunning == true
end

-- Tracked connections — all disconnected automatically on re-execute
local _connections = {}
local function safeConnect(signal, fn)
    local conn = signal:Connect(fn)
    table.insert(_connections, conn)
    return conn
end
onCleanup(function()
    for _, c in ipairs(_connections) do
        pcall(function() c:Disconnect() end)
    end
    _connections = {}
end)

