end)

local RawMeta = getrawmetatable(game)
local oldIndex    = RawMeta.__index
local oldNewIndex = RawMeta.__newindex
local oldNamecall = RawMeta.__namecall
setreadonly(RawMeta, false)

RawMeta.__index = newcclosure(function(self, key)
    if not checkcaller() and Axiom['Silent Aim']['Enabled'] and TargetPart then
        if self == Mouse and (key == 'Hit' or key == 'Target') then
            local pos = TargetPart.Position + (TargetPart.Velocity * Axiom['Silent Aim']['Prediction'])
            if key == 'Hit' then return CFrame.new(pos) elseif key == 'Target' then return TargetPart end
        end
    end
    return oldIndex(self, key)
end)

RawMeta.__newindex = newcclosure(function(self, key, value)
    if not checkcaller() then
        local PlayerMods = Axiom['Player Modifications']
        if key == "JumpPower" and self:IsA("Humanoid") then
            if PlayerMods['Jump Power']['Enabled'] then
                return oldNewIndex(self, key, PlayerMods['Jump Power']['Power'] or 100)
            elseif PlayerMods['No Jump Cooldown']['Enabled'] then
                return oldNewIndex(self, key, 50)
            end
        end
    end
    return oldNewIndex(self, key, value)
end)

RawMeta.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if not checkcaller() and Axiom['Silent Aim']['Enabled'] and TargetPart then
        local pos = TargetPart.Position + (TargetPart.Velocity * Axiom['Silent Aim']['Prediction'])
        if method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" or method == "FindPartOnRay" then
            args[1] = Ray.new(Camera.CFrame.Position, (pos - Camera.CFrame.Position).Unit * 1000)
            return oldNamecall(self, unpack(args))
        elseif method == "Raycast" then
            args[2] = (pos - args[1]).Unit * 1000
            return oldNamecall(self, unpack(args))
        end
    end
    return oldNamecall(self, ...)
end)

setreadonly(RawMeta, true)

-- Restore original metamethods on re-execute so we don't double-hook
onCleanup(function()
    pcall(function()
        setreadonly(RawMeta, false)
        RawMeta.__index    = oldIndex
        RawMeta.__newindex = oldNewIndex
        RawMeta.__namecall = oldNamecall
        setreadonly(RawMeta, true)
    end)
end)

