safeConnect(UserInputService.InputBegan, function(Input, Processed)
    if not Processed then
        local Binds = Axiom['General']['Binds']
        if Input.KeyCode == Enum.KeyCode[Binds['Silent Aim']] then
            Axiom['Silent Aim']['Enabled'] = not Axiom['Silent Aim']['Enabled']
            if Axiom['Silent Aim']['Mode'] == 'Target' then
                if Axiom['Silent Aim']['Enabled'] then Target = GetClosestPlayer() else Target = nil TargetPart = nil end
            end

        elseif Input.KeyCode == Enum.KeyCode[Binds['Rapid Fire']] then
            Axiom['Weapon Modifiers']['Rapid Fire']['Enabled'] = not Axiom['Weapon Modifiers']['Rapid Fire']['Enabled']

        elseif Input.KeyCode == Enum.KeyCode[Binds['Jump Power']] then
            Axiom['Player Modifications']['Jump Power']['Enabled'] = not Axiom['Player Modifications']['Jump Power']['Enabled']

        elseif Input.KeyCode == Enum.KeyCode[Binds['Walk Speed']] then
            local WS = Axiom['Player Modifications']['Walk Speed']
            if WS['Enabled'] then
                speedEnabled = not speedEnabled
                if not speedEnabled then
                    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass('Humanoid')
                    if hum then hum.WalkSpeed = 16 end
                end
            end

        elseif Binds['Cam Lock'] and Input.KeyCode == Enum.KeyCode[Binds['Cam Lock']] then
            local CL = Axiom['Cam Lock']
            if CL['Mode'] == 'Automatic' then
                CL['Enabled'] = not CL['Enabled']
                if not CL['Enabled'] then
                    camLockEnabled = false
                    camLockTarget  = nil
                    camLockPart    = nil
                end
            else -- Target mode
                if camLockEnabled then
                    camLockEnabled = false
                    camLockTarget  = nil
                    camLockPart    = nil
                else
                    local p = GetClosestPlayerForCamLock()
                    if p then
                        camLockEnabled = true
                        camLockTarget  = p
                        camLockPart    = GetCamLockAimPart(p.Character)
                    end
                end
            end
        end
        if Input.UserInputType == Enum.UserInputType.MouseButton1 then
            isMouseDown = true
        end
    end
end)

safeConnect(UserInputService.InputEnded, function(Input)
