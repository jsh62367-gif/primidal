            ["Love Kukri"]       = { soundid = "", animationid = "", pos = Vector3.new(-0.14,0.14,-1.62), rot = Vector3.new(-90,180,-4.97), textureid = "rbxassetid://12124159284", particle = true },
            ["Emerald"]          = { soundid = "", animationid = "", pos = Vector3.new(-0.03,-0.06,-0.92), rot = Vector3.new(168.63,90,108) },
            ["GPO-Knife"]        = { soundid = "rbxassetid://4604390759", animationid = "rbxassetid://14014278925", pos = Vector3.new(0,-0.32,-1.07), rot = Vector3.new(90,-97.4,90) },
            ["Golden Age Tanto"] = { soundid = "rbxassetid://5917819099", animationid = "rbxassetid://13473404819", pos = Vector3.new(0,-0.20,-1.2),  rot = Vector3.new(90,263.7,180) },
        }

        -- Clean up a knife skin from a tool
        local function cleanKnife(tool)
            local data = knifeData[tool]
            if data then
                if data.track then pcall(function() data.track:Stop(); data.track:Destroy() end) end
                for _, w in ipairs(data.welds or {}) do pcall(function() w:Destroy() end) end
                for _, s in ipairs(data.sounds or {}) do pcall(function() if s.Parent then s:Destroy() end end) end
            end
            local mesh = tool:FindFirstChild("Default")
            if mesh then
                for _, v in ipairs(mesh:GetChildren()) do
                    if v.Name == "Handle.R" or v:IsA("Model") or (v:IsA("BasePart") and v.Name ~= "Default") then
                        v:Destroy()
                    end
                end
                mesh.Transparency = 0
            end
            knifeData[tool] = nil
        end

        -- Apply a knife skin
        local function applyKnife(char, tool, skinName)
            local cfg = knifeSkins[skinName]

            -- If not in hardcoded table, try to read config from the game's SkinModules.Knives folder
            if not cfg then
                local knivesFolder = RS:FindFirstChild("SkinModules") and RS.SkinModules:FindFirstChild("Knives")
                local skinModel = knivesFolder and knivesFolder:FindFirstChild(skinName)
                if not skinModel then return end -- skin doesn't exist in game either, give up

                -- Try to read pos/rot/sound/anim from attributes the game may store on the model
                local px = skinModel:GetAttribute("PosX") or 0
                local py = skinModel:GetAttribute("PosY") or -0.15
                local pz = skinModel:GetAttribute("PosZ") or -0.9
                local rx = skinModel:GetAttribute("RotX") or 89.05
                local ry = skinModel:GetAttribute("RotY") or 90.95
                local rz = skinModel:GetAttribute("RotZ") or 180
                local sid = skinModel:GetAttribute("SoundId") or ""
                local aid = skinModel:GetAttribute("AnimationId") or ""

                -- Also check for a child StringValue/NumberValue config pattern some Da Hood skins use
                local posVal = skinModel:FindFirstChild("Position")
                local rotVal = skinModel:FindFirstChild("Rotation")
                if posVal and posVal:IsA("Vector3Value") then
                    px, py, pz = posVal.Value.X, posVal.Value.Y, posVal.Value.Z
                end
                if rotVal and rotVal:IsA("Vector3Value") then
                    rx, ry, rz = rotVal.Value.X, rotVal.Value.Y, rotVal.Value.Z
                end

                cfg = {
                    soundid     = sid,
                    animationid = aid,
                    pos         = Vector3.new(px, py, pz),
                    rot         = Vector3.new(rx, ry, rz),
                }
            end

            local hum   = char:FindFirstChild("Humanoid")
            local rhand = char:FindFirstChild("RightHand")
            if not hum or not rhand then return end

            cleanKnife(tool)
            knifeData[tool] = { track = nil, welds = {}, sounds = {} }
            local data = knifeData[tool]

            local mesh = tool:FindFirstChild("Default")
            if not mesh then return end
            mesh.Transparency = 1

            local knivesFolder = RS:FindFirstChild("SkinModules") and RS.SkinModules:FindFirstChild("Knives")
            if not knivesFolder then return end
            local skinModel = knivesFolder:FindFirstChild(skinName)
            if not skinModel then return end

            local clone = skinModel:Clone()
            clone.Name = skinName

            -- Invisible anchor part welded to right hand
            local handr = Instance.new("Part")
            handr.Name        = "Handle.R"
            handr.Transparency = 1
            handr.CanCollide  = false
            handr.Anchored    = false
            handr.Size        = Vector3.new(0.001, 0.001, 0.001)
            handr.Massless    = true
            handr.Parent      = mesh

            local m6d      = Instance.new("Motor6D")
            m6d.Name       = "Handle.R"
            m6d.Part0      = rhand
            m6d.Part1      = handr
            m6d.Parent     = handr

            local offset = CFrame.new(cfg.pos) * CFrame.Angles(math.rad(cfg.rot.X), math.rad(cfg.rot.Y), math.rad(cfg.rot.Z))

            if clone:IsA("Model") then
                if not clone.PrimaryPart then
                    for _, c in ipairs(clone:GetChildren()) do
                        if c:IsA("BasePart") then clone.PrimaryPart = c; break end
                    end
                end
                if clone.PrimaryPart then
                    for _, p in ipairs(clone:GetDescendants()) do
                        if p:IsA("BasePart") then
                            p.CanCollide = false; p.Massless = true; p.Anchored = false
                            local w = Instance.new("Weld")
                            w.Part0 = handr; w.Part1 = p
                            w.C0 = offset
                            w.C1 = p.CFrame:ToObjectSpace(clone.PrimaryPart.CFrame)
                            w.Parent = p
                            table.insert(data.welds, w)
                        end
                    end
                end
                clone.Parent = mesh
            elseif clone:IsA("BasePart") then
                clone.CanCollide = false; clone.Massless = true; clone.Anchored = false
                if clone:IsA("MeshPart") and cfg.textureid then clone.TextureID = cfg.textureid end
                if cfg.particle then
                    local pf = RS:FindFirstChild("SkinAssets") and RS.SkinAssets:FindFirstChild("GunHandleParticle")
                    local ps = pf and pf:FindFirstChild(skinName)
                    local pe = ps and ps:FindFirstChild("ParticleEmitter")
                    if pe then pe:Clone().Parent = clone end
                end
                clone.Parent = mesh
                local w = Instance.new("Weld")
                w.Part0 = handr; w.Part1 = clone; w.C0 = offset; w.Parent = clone
                table.insert(data.welds, w)
            end

            -- Animation
            local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
            if cfg.animationid and cfg.animationid ~= "" then
                local anim = Instance.new("Animation")
                anim.AnimationId = cfg.animationid
                local track = animator:LoadAnimation(anim)
                track.Looped = false; track:Play()
                data.track = track
                anim:Destroy()
                track.Ended:Once(function() if data.track == track then data.track = nil end; track:Destroy() end)
            end

            -- Sound
            if cfg.soundid and cfg.soundid ~= "" then
                local snd = Instance.new("Sound")
                snd.SoundId = cfg.soundid; snd.Parent = workspace; snd:Play()
                table.insert(data.sounds, snd)
                snd.Ended:Connect(function() snd:Destroy() end)
            end

            tool:SetAttribute("CurrentKnifeSkin", skinName)
        end

        -- Apply a gun skin via SkinModules
        local function applyGun(tool, skinName)
            local orig = tool:FindFirstChildOfClass("MeshPart")
            if not orig then return end
            local skinModules = RS:FindFirstChild("SkinModules")
            if not skinModules then return end
            local ok, req = pcall(require, skinModules)
            if not ok or not req then return end
            local info = req[tool.Name] and req[tool.Name][skinName]
            if not info then return end

            -- Remove old skin meshes
            for _, v in ipairs(tool:GetChildren()) do
                if v:IsA("MeshPart") and v ~= orig then v:Destroy() end
            end

            local skinPart = info.TextureID
            if typeof(skinPart) == "Instance" then
                local clone = skinPart:Clone()
                clone.Parent = tool; clone.CFrame = orig.CFrame; clone.Name = "CurrentSkin"
                local w = Instance.new("Weld")
                w.Part0 = clone; w.Part1 = orig; w.C0 = info.CFrame:Inverse(); w.Parent = clone
                orig.Transparency = 1
            else
                orig.TextureID = skinPart; orig.Transparency = 0
            end

            -- Shoot sound swap
            local handle = tool:FindFirstChild("Handle")
            if handle then
                local shoot = handle:FindFirstChild("ShootSound")
                if shoot then
                    local sounds = RS:FindFirstChild("SkinAssets")
                        and RS.SkinAssets:FindFirstChild("GunShootSounds")
                        and RS.SkinAssets.GunShootSounds:FindFirstChild(tool.Name)
                    local obj = sounds and sounds:FindFirstChild(skinName)
                    if obj then shoot.SoundId = obj.Value end
                end
                -- Particle
                local pf = RS:FindFirstChild("SkinAssets") and RS.SkinAssets:FindFirstChild("GunHandleParticle")
                local ps = pf and pf:FindFirstChild(skinName)
                local pe = ps and ps:FindFirstChild("ParticleEmitter")
                if pe then
                    for _, ex in ipairs(handle:GetChildren()) do
                        if ex:IsA("ParticleEmitter") then ex:Destroy() end
                    end
                    pe:Clone().Parent = handle
                end
                handle:SetAttribute("SkinName", skinName)
            end
        end

        -- Wire up a tool when equipped
        local function setupTool(tool)
            if not tool:IsA("Tool") then return end
            if toolRegistry[tool] then return end
            toolRegistry[tool] = true

            tool.Equipped:Connect(function()
                local char = tool.Parent
                if char ~= LocalPlayer.Character then return end
                local skin = SC_C['Weapons'][tool.Name]
                if not skin or skin == "" then return end
                if tool.Name == "[Knife]" then
                    applyKnife(char, tool, skin)
                else
                    applyGun(tool, skin)
                end
            end)

            tool.Unequipped:Connect(function()
                if tool.Name == "[Knife]" then cleanKnife(tool) end
            end)

            -- Apply immediately if already equipped
            if tool.Parent == LocalPlayer.Character then
                local skin = SC_C['Weapons'][tool.Name]
                if skin and skin ~= "" then
                    if tool.Name == "[Knife]" then
                        task.spawn(applyKnife, LocalPlayer.Character, tool, skin)
                    else
                        task.spawn(applyGun, tool, skin)
                    end
                end
            end
        end

        local function watchChar(char)
            if not char then return end
            for _, v in ipairs(char:GetChildren()) do
                if v:IsA("Tool") then setupTool(v) end
            end
            char.ChildAdded:Connect(function(v)
                if v:IsA("Tool") then setupTool(v) end
            end)
        end

        if LocalPlayer.Character then watchChar(LocalPlayer.Character) end
        LocalPlayer.CharacterAdded:Connect(watchChar)

        for _, v in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if v:IsA("Tool") then setupTool(v) end
        end
        LocalPlayer.Backpack.ChildAdded:Connect(function(v)
            if v:IsA("Tool") then setupTool(v) end
        end)
    end
end



-- HUD
do
    -- Remove any existing HUD from a previous run
    pcall(function()
        local cg = game:GetService("CoreGui")
        local old = cg:FindFirstChild("PrimildalHUD")
        if old then old:Destroy() end
        local old2 = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("PrimildalHUD")
        if old2 then old2:Destroy() end
    end)

    local hudGui = Instance.new("ScreenGui")
    hudGui.Name = "PrimildalHUD"
    hudGui.ResetOnSpawn = false
    hudGui.IgnoreGuiInset = true
    pcall(function() hudGui.Parent = game:GetService("CoreGui") end)
    if not hudGui.Parent then hudGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
    onCleanup(function() pcall(function() hudGui:Destroy() end) end)

    local hotkeyLabel = Instance.new("TextLabel")
    hotkeyLabel.BackgroundTransparency = 1
    hotkeyLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    hotkeyLabel.Position = UDim2.new(0.5, 0, 0, 900)
    hotkeyLabel.AutomaticSize = Enum.AutomaticSize.XY
    hotkeyLabel.RichText = true
    hotkeyLabel.Font = Enum.Font.SourceSansBold
    hotkeyLabel.TextStrokeTransparency = 0
    hotkeyLabel.TextXAlignment = Enum.TextXAlignment.Center
    hotkeyLabel.TextYAlignment = Enum.TextYAlignment.Center
    hotkeyLabel.Visible = true
    hotkeyLabel.Parent = hudGui

    -- Pull colors and title from config
    local HUD_C = Axiom['General']['HUD']

    local function rgb(c)
        return string.format("rgb(%d, %d, %d)", math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255))
    end

    local separator = '\n'

    safeConnect(RunService.Heartbeat, function()
        if not isAlive() then return end
        local SA    = Axiom['Silent Aim']
        local WM    = Axiom['Weapon Modifiers']
        local ESP_C = Axiom['ESP']
        local PM    = Axiom['Player Modifications']

        local activeFeatures = {}

        -- Read colors live so changes take effect without restart
        local titleColor   = HUD_C['Title Color']   or Color3.fromRGB(143, 174, 211)
        local featureColor = HUD_C['Feature Color'] or Color3.fromRGB(255, 255, 255)
        local activeColor  = HUD_C['Active Color']  or Color3.fromRGB(255, 255, 255)

        local tColorStr = rgb(titleColor)
        local fColorStr = rgb(featureColor)
        local tgtStr    = rgb(activeColor)

        -- Build title: "CustomText / Primidal" or just "Primidal"
        local customTitle = HUD_C['Title'] or ""
        local titleText
        if customTitle ~= "" then
            titleText = customTitle .. " / Primidal"
        else
            titleText = "Primidal"
        end

        local function row(feat, val)
            return string.format('<font color="%s">%s</font> <font color="%s">-</font> <font color="%s">%s</font>', fColorStr, feat, tColorStr, tgtStr, val)
        end

        if SA['Enabled'] and Target then
            table.insert(activeFeatures, row("Silent Aim", Target.Name))
        end
        if Axiom['Cam Lock']['Enabled'] then
            if camLockEnabled and camLockTarget then
                table.insert(activeFeatures, row("Cam Lock", camLockTarget.Name))
            else
                table.insert(activeFeatures, row("Cam Lock", "scanning"))
            end
        end
        if WM['Rapid Fire']['Enabled'] then
            table.insert(activeFeatures, row("Rapid Fire", "on"))
        end
        if WM['Range']['Enabled'] then
            table.insert(activeFeatures, row("Inf Range", "on"))
        end
        if ESP_C['Enabled'] then
            table.insert(activeFeatures, row("ESP", "on"))
        end
        if PM['Walk Speed']['Enabled'] and speedEnabled then
            table.insert(activeFeatures, row("Speed", tostring(PM['Walk Speed']['Value'])))
        end
        if PM['Jump Power']['Enabled'] then
            table.insert(activeFeatures, row("Jump Power", tostring(PM['Jump Power']['Power'])))
        end

        if #activeFeatures > 0 then
            local featuresText = table.concat(activeFeatures, separator)
            hotkeyLabel.Text = '<font size="22" color="' .. tColorStr .. '">' .. titleText .. '</font>\n<font size="13">' .. featuresText .. '</font>'
        else
            hotkeyLabel.Text = '<font size="22" color="' .. tColorStr .. '">' .. titleText .. '</font>'
        end
    end)
end

