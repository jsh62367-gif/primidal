    if CL['Enabled'] then
        -- Automatic mode: retarget every frame
        if CL['Mode'] == 'Automatic' then
            local p = GetClosestPlayerForCamLock()
            if p and p.Character then
                camLockEnabled = true
                camLockTarget  = p
                camLockPart    = GetCamLockAimPart(p.Character)
            else
                camLockEnabled = false
                camLockTarget  = nil
                camLockPart    = nil
            end
        end

        -- Validate existing target lock
        if camLockEnabled and camLockTarget then
            local char = camLockTarget.Character
            local hum  = char and char:FindFirstChildOfClass('Humanoid')
            if not char or not hum or hum.Health <= 0 or clIsKnocked(char) then
                camLockEnabled = false
                camLockTarget  = nil
                camLockPart    = nil
            else
                -- Refresh aim part each frame (handles 'Closest Part' mode)
                camLockPart = GetCamLockAimPart(char)
            end
        end

        -- Apply camera rotation toward target
        if camLockEnabled and camLockPart then
            local pred    = CL['Prediction']
            local vel     = camLockPart.AssemblyLinearVelocity or Vector3.zero
            -- Scale prediction by distance so close targets don't over-predict
            local dist    = (camLockPart.Position - Camera.CFrame.Position).Magnitude
            local scale   = math.clamp(dist / 100, 0.05, 1)
            local aimPos  = camLockPart.Position + Vector3.new(
                vel.X * (pred['X'] or 0) * scale,
                vel.Y * (pred['Y'] or 0) * scale,
                vel.Z * (pred['Z'] or 0) * scale
            )

            local targetCF = CFrame.new(Camera.CFrame.Position, aimPos)
            local smooth   = math.clamp(CL['Smoothness'] or 0.12, 0, 0.99)

            -- Smooth interpolation: lower smoothness = faster lock
            -- Uses frame-rate independent lerp so it feels consistent at any FPS
            local alpha = 1 - smooth
            Camera.CFrame = Camera.CFrame:Lerp(targetCF, alpha)
        end

        -- FOV circle
        local fov = CL['FOV']
        if fov['Enabled'] and fov['Visible'] then
            CLFovCircle.Position    = UserInputService:GetMouseLocation()
            CLFovCircle.Radius      = fov['Radius']
            CLFovCircle.Color       = fov['Color'] or Color3.fromRGB(255, 255, 100)
            CLFovCircle.Visible     = true
        else
