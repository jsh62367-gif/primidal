do
    local IR           = shared.primidal['Rage']['Infinite Range']
    local TARGET_PLACE = 75947843575468

    if IR['Enabled'] and game.PlaceId == TARGET_PLACE then

        local modifiedBullets = {}

        local function modifyBulletForInfiniteRange(bullet)
            if modifiedBullets[bullet] then return end
            modifiedBullets[bullet] = true
            if bullet:IsA("BasePart") then
                local bv = bullet:FindFirstChild("BodyVelocity")
                if bv then
                    bv.Velocity  = bullet.CFrame.LookVector * 5000
                    bv.MaxForce  = Vector3.new(math.huge, math.huge, math.huge)
                else
                    bv = Instance.new("BodyVelocity")
                    bv.Velocity  = bullet.CFrame.LookVector * 5000
                    bv.MaxForce  = Vector3.new(math.huge, math.huge, math.huge)
                    bv.Parent    = bullet
                end
                local lastTPPos        = bullet.Position
                local distanceTraveled = 0
                local TP_DISTANCE      = 30
                local bConn = RunService.Heartbeat:Connect(function()
                    if not isAlive() then return end
                    if not bullet or not bullet.Parent then return end
                    if not IR['Enabled'] then return end
                    local cur = bullet.Position
                    distanceTraveled = distanceTraveled + (cur - lastTPPos).Magnitude
                    lastTPPos = cur
                    if distanceTraveled >= TP_DISTANCE then
                        bullet.CFrame    = bullet.CFrame + (bullet.CFrame.LookVector * 0.5)
                        distanceTraveled = 0
                    end
                end)
                onCleanup(function() pcall(function() bConn:Disconnect() end) end)
            end
        end

        local scanConn = RunService.Heartbeat:Connect(function()
            if not isAlive() then return end
            if not IR['Enabled'] then return end
            for _, part in pairs(workspace:GetChildren()) do
                if part:IsA("BasePart") and part.Name:lower():find("bullet") then
                    modifyBulletForInfiniteRange(part)
                end
            end
            local bulletsFolder = workspace:FindFirstChild("Bullets")
            if bulletsFolder then
                for _, bullet in pairs(bulletsFolder:GetChildren()) do
                    modifyBulletForInfiniteRange(bullet)
                end
            end
        end)
        onCleanup(function() pcall(function() scanConn:Disconnect() end) end)

        pcall(function()
            local RS               = game:GetService("ReplicatedStorage")
            local MainEvent        = RS:WaitForChild("MainEvent", 5)
            local GunHandlerModule = RS:FindFirstChild("Modules")
                                     and RS.Modules:FindFirstChild("GunHandler")

            if MainEvent and hookmetamethod then
                local oldNc
                oldNc = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    local args   = {...}
                    if IR['Enabled'] and self == MainEvent and method == "FireServer" then
                        local eventName = tostring(args[1])
                        if eventName == "ShootGun" or eventName == "Shoot"
                            or eventName == "DoubleBarrel" or eventName == "Double-Barrel"
                            or eventName == "Shotgun" then
                            local hitPos    = args[3]
                            local muzzlePos = args[6]
                            if typeof(hitPos) ~= "Vector3" and typeof(args[2]) == "Vector3" then
                                hitPos = args[2]
                            end
                            if typeof(hitPos) == "Vector3" and typeof(muzzlePos) == "Vector3" then
                                local distance = (hitPos - muzzlePos).Magnitude
                                if distance > 15 then
                                    local direction  = (hitPos - muzzlePos).Unit
                                    local fakeHitPos = muzzlePos + (direction * IR['Bypass Pos'])
                                    if typeof(args[3]) == "Vector3" then args[3] = fakeHitPos end
                                    if typeof(args[5]) == "Vector3" then args[5] = fakeHitPos end
                                    if typeof(args[2]) == "Vector3" and args[2] == hitPos then
                                        args[2] = fakeHitPos
                                    end
                                end
                            end
                        end
                    end
                    return oldNc(self, unpack(args))
                end))
            end

            if GunHandlerModule and hookfunction then
                local GunHandler = require(GunHandlerModule)
                if GunHandler.getAim then
                    local oldGetAim
                    oldGetAim = hookfunction(GunHandler.getAim, function(hit, dist)
                        return oldGetAim(hit, IR['Enabled'] and IR['Range'] or dist)
                    end)
                end
                if GunHandler.shoot then
                    local oldShoot
                    oldShoot = hookfunction(GunHandler.shoot, function(data)
                        if IR['Enabled'] and typeof(data) == "table" then
                            data.Range = IR['Range']
                        end
                        return oldShoot(data)
                    end)
                end
            end
        end)
    end
end

do
    local function activateTool()
        local char = LocalPlayer.Character
        if not char then return end
        local tool = char:FindFirstChildOfClass('Tool')
        if tool and tool:IsDescendantOf(char) and tool.Name ~= '[Knife]' then
            tool:Activate()
        end
    end

    local function triggerShot(cooldown)
        local now     = DateTime.now().UnixTimestampMillis
        local char    = LocalPlayer.Character
        local gunCD   = 0.3
        if char then
            local tool = char:FindFirstChildOfClass('Tool')
            if tool then
                local cd = tool:FindFirstChild('ShootingCooldown')
                if cd then gunCD = cd.Value end
            end
        end
        local minCD = math.max(cooldown, gunCD * 0.75)
        if (now - TB_LastShot) >= minCD * 1000 then
            TB_LastShot = now
            activateTool()
        end
    end

    local tbConn = RunService.PreRender:Connect(function()
        if not isAlive() then return end
        local TB = shared.primidal['Triggerbot']
        if not TB['Enabled'] or not TB_State then return end

        local target
        if TB['Selection'] == 'Automatic' then
            target = SA_GetClosestPlayer()
        else
            target = TB_TargetLocked and TB_Target or nil
        end
        if not target then return end

        local targetChar = target.Character
        if not targetChar then return end
        local char = LocalPlayer.Character
        if not char then return end
        local tool = char:FindFirstChildOfClass('Tool')
        if not tool or not tool:FindFirstChild('Ammo') or tool.Name == '[Knife]' then return end
        if not TB_CanShoot then return end
        if SA_IsKnocked(targetChar) then return end
        local hum = targetChar:FindFirstChildOfClass('Humanoid')
        if not hum or hum.Health <= 0 then return end

        local selfHRP   = char:FindFirstChild('HumanoidRootPart')
        local targetHRP = targetChar:FindFirstChild('HumanoidRootPart')
        if not selfHRP or not targetHRP then return end

        if (selfHRP.Position - targetHRP.Position).Magnitude > (TB['Max Range'] or math.huge) then return end

        local aimPos = targetHRP.Position
        local predCfg = TB['Prediction']
        if predCfg and predCfg[1] == true then
            local vel = AB_GetDeltaVelocity(target)
            local m   = predCfg[2] or 0.13
            aimPos = aimPos + Vector3.new(vel.X * m, 0, vel.Z * m)
        end

        local sp, on = Camera:WorldToViewportPoint(aimPos)
        if not on then return end

        local shouldFire = false
        local hitCheck   = TB['Hit Check'] or 'FOV'

        if hitCheck == 'On Player' then
            local mouseTarget = Mouse.Target
            shouldFire = mouseTarget and mouseTarget:IsDescendantOf(targetChar)
        else
            local mp         = UserInputService:GetMouseLocation()
            local delta      = Vector2.new(sp.X, sp.Y) - mp
            local fovCfg     = TB['FOV']
            local depth      = sp.Z
            if depth <= 1 then return end
            local vp         = Camera.ViewportSize
            local scaleFactor = (targetHRP.Size.Y * vp.Y) / (depth * 2) * 80 / Camera.FieldOfView
            local scaledW    = fovCfg['Size']['Width']  * scaleFactor
            local scaledH    = fovCfg['Size']['Height'] * scaleFactor
            shouldFire = not fovCfg['Enabled']
                or (math.abs(delta.X) <= scaledW / 2 and math.abs(delta.Y) <= scaledH / 2)
        end

        if shouldFire then
            local delayCfg = TB['Delay']
            local cooldown = 0
            if delayCfg and delayCfg['Enabled'] then
                local mn = delayCfg['Value'][1] or 0
                local mx = delayCfg['Value'][2] or 0
                cooldown = mn + math.random() * (mx - mn)
            end
            triggerShot(cooldown)
        end
    end)
    onCleanup(function() pcall(function() tbConn:Disconnect() end) end)
end

