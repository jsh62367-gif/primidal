    local function setupAntiStomp(char)
        if koConn then pcall(function() koConn:Disconnect() end); koConn = nil end
        if not char then return end
        local bodyEffects = char:WaitForChild('BodyEffects', 5)
        if not bodyEffects then return end
        local ko = bodyEffects:WaitForChild('K.O', 5)
        if not ko then return end
        koConn = ko.Changed:Connect(function(knocked)
            local UTL = shared.primidal['Character']['Utilities']['Anti Stomp']
            if not UTL or not UTL['Enabled'] then return end
            if not knocked then return end
            local hrp = char:FindFirstChild('HumanoidRootPart')
            if not hrp then return end
            hrp.CFrame   = CFrame.new(0, -2147483647, 0)
            hrp.Velocity = Vector3.new(65536, 65534, 65536)
            local hum = char:FindFirstChildOfClass('Humanoid')
            if hum then
                for _ = 1, 10 do
                    hum.Health = 0
                    task.wait()
                end
            end
