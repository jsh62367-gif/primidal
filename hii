local conn = RunService.PreRender:Connect(function()
    if not isAlive() then return end

    local Cfg    = shared.primidal
    local Panel  = Cfg['Hotkeys']
    local ESP    = Cfg['Name ESP']
    local SA     = Cfg['Silent Aim']

    if SA['Enabled'] then
        if SA['Mode'] == 'Automatic' then
            SA_Target = SA_GetClosestPlayer()
        end
        if SA_Target and SA_Target.Character then
            local char = SA_Target.Character
            if SA_IsKnocked(char) then
                if SA['Mode'] == 'Target' then SA['Enabled'] = false end
                SA_Target = nil; SA_TargetPart = nil
            else
                SA_TargetPart = (SA['Hit Part'] == 'Closest Part')
                    and SA_GetClosestBodyPart(char)
                    or  char:FindFirstChild(SA['Hit Part'])
            end
        else
            SA_Target = nil; SA_TargetPart = nil
        end
    else
        SA_Target = nil; SA_TargetPart = nil
    end

    local fov = SA['FOV']
    if fov['Enabled'] then
        local avgRadius = (fov['Size']['X'] + fov['Size']['Y']) / 2
        SA_FOVCircle.Position = UserInputService:GetMouseLocation()
        SA_FOVCircle.Radius   = avgRadius
        SA_FOVCircle.Visible  = fov['Visible']
    else
        SA_FOVCircle.Visible = false
    end

    AB_UpdatePosCache()

    local AB = Cfg['Aimbot']
    if AB['Enabled'] and AB_TargetLocked and AB_Target then
        local char = AB_Target.Character
        local hum  = char and char:FindFirstChildOfClass('Humanoid')
        if not char or not hum or hum.Health <= 0 or SA_IsKnocked(char) then
            AB_TargetLocked = false
            AB_Target = nil
        else
            local part = AB_GetAimPart(char)
            if part then
                local targetPos = part.Position

                local pred = AB['Prediction']
                if pred['Enabled'] then
                    local vel = AB_GetDeltaVelocity(AB_Target)
                    local pv  = pred['Value'] or 0.13
                    targetPos = targetPos + vel * Vector3.new(pv, pv, pv)
                end

                local camPos     = Camera.CFrame.Position
                local desiredCF  = CFrame.new(camPos, targetPos)
                local smoothCfg  = AB['Smoothness']

                if smoothCfg['Enabled'] then
                    local alpha     = smoothCfg['Value'] or 0.1
                    local lerpedPos = camPos:Lerp(desiredCF.Position, alpha)
                    local lerpedRot = Camera.CFrame:Lerp(desiredCF, alpha)
