local AB_PosCache          = {}
local AB_PosCacheSize      = 8
local AB_PosSampleInterval = 0.03
local AB_LastCacheUpdate   = 0

local function AB_UpdatePosCache()
    local now = os.clock()
    if (now - AB_LastCacheUpdate) < AB_PosSampleInterval then return end
    AB_LastCacheUpdate = now
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild('HumanoidRootPart')
            if hrp then
                if not AB_PosCache[player] then AB_PosCache[player] = {} end
                local cache = AB_PosCache[player]
                local last  = cache[1]
                if not last or (now - last.t) >= AB_PosSampleInterval then
                    table.insert(cache, 1, { pos = hrp.Position, t = now })
                    if #cache > AB_PosCacheSize then cache[#cache] = nil end
                end
            end
        end
    end
    for player in pairs(AB_PosCache) do
        if not player.Parent then AB_PosCache[player] = nil end
    end
end

local function AB_GetDeltaVelocity(player)
    local cache = AB_PosCache[player]
    if not cache or #cache < 2 then return Vector3.zero end
    local newest  = cache[1]
    local oldest  = cache[math.min(#cache, 4)]
    local dt      = newest.t - oldest.t
    if dt <= 0.001 then return Vector3.zero end
    return (newest.pos - oldest.pos) / dt
end

local function AB_GetClosestPlayer()
    local AB  = shared.primidal['Aimbot']
    local fov = AB['FOV']
    local mp  = UserInputService:GetMouseLocation()
    local limit = (fov['Enabled'] and fov['Size'] and ((fov['Size']['X'] + fov['Size']['Y']) / 2)) or math.huge
    local best, bd = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char then continue end
        if SA_IsKnocked(char) then continue end
        local hum = char:FindFirstChildOfClass('Humanoid')
        if not hum or hum.Health <= 0 then continue end
        local hrp = char:FindFirstChild('HumanoidRootPart')
        if not hrp then continue end
        local dist3d = (hrp.Position - Camera.CFrame.Position).Magnitude
        if dist3d > (AB['Max Range'] or math.huge) then continue end
        local sp, on = Camera:WorldToViewportPoint(hrp.Position)
        if on and sp.Z > 0 then
            local d = (Vector2.new(sp.X, sp.Y) - mp).Magnitude
            if d <= limit and d < bd then bd = d; best = player end
        end
    end
    return best
end

local function AB_GetAimPart(char)
    local AB = shared.primidal['Aimbot']
    local hp = AB['Hit Part']
    if hp == 'Closest Part' then return SA_GetClosestBodyPart(char) end
    return char:FindFirstChild(hp) or char:FindFirstChild('HumanoidRootPart')
end
local RawMeta     = getrawmetatable(game)
local oldIndex    = RawMeta.__index
local oldNamecall = RawMeta.__namecall
setreadonly(RawMeta, false)

RawMeta.__index = newcclosure(function(self, key)
    if not checkcaller() then
        local SA = shared.primidal['Silent Aim']
        if SA['Enabled'] and SA_TargetPart then
            if self == Mouse and (key == 'Hit' or key == 'Target') then
                local pred = SA['Prediction']
                local vel  = SA_TargetPart.Velocity
                local pos  = SA_TargetPart.Position
                if pred['Enabled'] then
                    local v = pred['Values']
                    pos = pos + Vector3.new(vel.X * v['X'], vel.Y * v['Y'], vel.Z * v['Z'])
                end
                if key == 'Hit'    then return CFrame.new(pos) end
                if key == 'Target' then return SA_TargetPart end
            end
        end
    end
    return oldIndex(self, key)
end)

RawMeta.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args   = {...}
    if not checkcaller() then
        local SA = shared.primidal['Silent Aim']
        if SA['Enabled'] and SA_TargetPart then
            local pred = SA['Prediction']
            local vel  = SA_TargetPart.Velocity
            local pos  = SA_TargetPart.Position
            if pred['Enabled'] then
                local v = pred['Values']
                pos = pos + Vector3.new(vel.X * v['X'], vel.Y * v['Y'], vel.Z * v['Z'])
            end
            if method == "FindPartOnRayWithIgnoreList"
                or method == "FindPartOnRayWithWhitelist"
                or method == "FindPartOnRay" then
                args[1] = Ray.new(Camera.CFrame.Position, (pos - Camera.CFrame.Position).Unit * 1000)
                return oldNamecall(self, unpack(args))
            elseif method == "Raycast" then
                args[2] = (pos - args[1]).Unit * 1000
                return oldNamecall(self, unpack(args))
            end
        end
    end
    return oldNamecall(self, ...)
end)

setreadonly(RawMeta, true)

onCleanup(function()
    pcall(function()
        setreadonly(RawMeta, false)
        RawMeta.__index    = oldIndex
        RawMeta.__namecall = oldNamecall
        setreadonly(RawMeta, true)
    end)
end)

