do
    local function getMovKey(char)
        local MOV = shared.primidal['Character']['Movement']
        local tool = char:FindFirstChildOfClass('Tool')
        local hum  = char:FindFirstChildOfClass('Humanoid')
        local isReload = false
        if tool then
            local ammo = tool:FindFirstChild('Ammo')
            if ammo and ammo.Value == 0 then isReload = true end
            if not isReload then
                local reloading = tool:FindFirstChild('Reloading')
                if reloading and reloading.Value then isReload = true end
            end
        end
        local isLowHealth = hum and hum.Health > 0 and hum.Health <= 25
        if isLowHealth then return 'Low Health' end
        if isReload    then return 'Reload' end
        return 'Normal'
    end

    local wsConn = RunService.RenderStepped:Connect(function()
        if not isAlive() then return end
        local MOV = shared.primidal['Character']['Movement']
        local WS  = MOV['Walk Speed']
        if not WS['Enabled'] or not MOV_SpeedActive then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass('Humanoid')
        if not hum then return end
        local key  = getMovKey(char)
        local mult = WS[key] and WS[key]['Multiplier'] or 1
        hum.WalkSpeed = mult * 100
    end)
    onCleanup(function() pcall(function() wsConn:Disconnect() end) end)

    local jpConn = RunService.RenderStepped:Connect(function()
        if not isAlive() then return end
        local MOV = shared.primidal['Character']['Movement']
        local JP  = MOV['Jump Power']
        if not JP['Enabled'] or not MOV_JumpActive or JP['Spiderman Mode'] then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass('Humanoid')
        if not hum then return end
        local key  = getMovKey(char)
        local mult = JP[key] and JP[key]['Multiplier'] or 1
        hum.JumpPower = mult * 100
    end)
    onCleanup(function() pcall(function() jpConn:Disconnect() end) end)

    local function setupCharMovement(char)
        if not char then return end
        local hum = char:FindFirstChildOfClass('Humanoid')
        if not hum then return end
        local defaultJP = hum.JumpPower

        hum:GetPropertyChangedSignal('JumpPower'):Connect(function()
            local MOV = shared.primidal['Character']['Movement']
            if not MOV['No Jump Cooldown'] then return end
            if hum.JumpPower == 0 then
                local JP = MOV['Jump Power']
                if JP['Enabled'] and MOV_JumpActive and not JP['Spiderman Mode'] then
                    local key  = getMovKey(char)
                    local mult = JP[key] and JP[key]['Multiplier'] or 1
                    hum.JumpPower = mult * 100
                else
                    hum.JumpPower = defaultJP
                end
            end
        end)

        hum.StateChanged:Connect(function(_, newState)
            local MOV = shared.primidal['Character']['Movement']
            if not MOV['Anti Fall'] then return end
            if newState == Enum.HumanoidStateType.FallingDown
                or newState == Enum.HumanoidStateType.Ragdoll then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end)

        local wallParams = RaycastParams.new()
        wallParams.FilterType = Enum.RaycastFilterType.Exclude
        wallParams.FilterDescendantsInstances = {char}

        local function isNearWall(hrp)
            local origin = hrp.Position
            local cf     = hrp.CFrame
            for _, dir in ipairs({ cf.LookVector, -cf.LookVector, cf.RightVector, -cf.RightVector }) do
                if workspace:Raycast(origin, dir * 3, wallParams) then return true end
            end
            return false
        end

        local freefallStart = 0
        hum.StateChanged:Connect(function(_, newState)
            if newState == Enum.HumanoidStateType.Freefall then
                freefallStart = tick()
            elseif newState == Enum.HumanoidStateType.Landed
                or newState == Enum.HumanoidStateType.Running then
                freefallStart = 0
            end
        end)

        UserInputService.JumpRequest:Connect(function()
            local MOV = shared.primidal['Character']['Movement']
            local JP  = MOV['Jump Power']
            if not JP['Enabled'] or not MOV_JumpActive or not JP['Spiderman Mode'] then return end
            local hrp = char:FindFirstChild('HumanoidRootPart')
            if not hrp then return end
            if hum:GetState() ~= Enum.HumanoidStateType.Freefall then return end
            if freefallStart == 0 or (tick() - freefallStart) < 0.2 then return end
            if not isNearWall(hrp) then return end
            local key  = getMovKey(char)
            local mult = JP[key] and JP[key]['Multiplier'] or 1
            hum.JumpPower = mult * 100
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            local resetConn
            resetConn = hum.StateChanged:Connect(function(_, ns)
                if ns == Enum.HumanoidStateType.Freefall
                    or ns == Enum.HumanoidStateType.Landed then
                    resetConn:Disconnect()
                    hum.JumpPower = defaultJP
                end
            end)
        end)
    end

    if LocalPlayer.Character then setupCharMovement(LocalPlayer.Character) end
    local charConn = LocalPlayer.CharacterAdded:Connect(setupCharMovement)
    onCleanup(function() pcall(function() charConn:Disconnect() end) end)
end

