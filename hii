local inputConn = UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    local binds = shared.primidal['Keybinds']

    local multibinds    = shared.primidal['Multibinds']
    local handledByMulti = {}

    for _, group in ipairs(multibinds) do
        if not group['Enabled'] then continue end
        local key = group['Key']
        if not key then continue end
        local matched = false
        pcall(function()
            matched = input.KeyCode == Enum.KeyCode[key:upper()]
        end)
        if not matched then continue end

        local allOn = true
        for _, feat in ipairs(group['Features']) do
            if feat == 'Silent Aim' then
                if not shared.primidal['Silent Aim']['Enabled'] then allOn = false end
            elseif feat == 'Triggerbot' then
                if not TB_State then allOn = false end
            elseif feat == 'Aimbot' then
                if not (shared.primidal['Aimbot']['Enabled'] and AB_TargetLocked) then allOn = false end
            elseif feat == 'ESP' then
                if not shared.primidal['Name ESP']['Enabled'] then allOn = false end
            end
        end

        local turnOn = not allOn

        for _, feat in ipairs(group['Features']) do
            handledByMulti[feat] = true
            if feat == 'Silent Aim' then
                local SA = shared.primidal['Silent Aim']
                SA['Enabled'] = turnOn
                if SA['Mode'] == 'Target' then
                    if turnOn then SA_Target = SA_GetClosestPlayer()
                    else SA_Target = nil; SA_TargetPart = nil end
                end
            elseif feat == 'Triggerbot' then
                TB_State = turnOn
                if not turnOn then TB_Target = nil end
            elseif feat == 'Aimbot' then
                local AB = shared.primidal['Aimbot']
                if turnOn then
                    AB_TargetLocked = true
                    AB_Target = AB_GetClosestPlayer()
                else
                    AB_TargetLocked = false
                    AB_Target = nil
                end
            elseif feat == 'ESP' then
                shared.primidal['Name ESP']['Enabled'] = turnOn
            end
        end
    end

    local espKey = binds['ESP Toggle']
    if espKey and not handledByMulti['ESP'] then
        pcall(function()
            if input.KeyCode == Enum.KeyCode[espKey:upper()] then
                shared.primidal['Name ESP']['Enabled'] = not shared.primidal['Name ESP']['Enabled']
            end
        end)
    end

    local saKey = binds['Silent Aim Toggle']
    if saKey and not handledByMulti['Silent Aim'] then
        pcall(function()
            if input.KeyCode == Enum.KeyCode[saKey:upper()] then
                local SA = shared.primidal['Silent Aim']
                SA['Enabled'] = not SA['Enabled']
                if SA['Mode'] == 'Target' then
                    if SA['Enabled'] then
                        SA_Target = SA_GetClosestPlayer()
                    else
                        SA_Target = nil
                        SA_TargetPart = nil
                    end
                end
            end
        end)
    end

    local abKey = binds['Aimbot Toggle']
    if abKey and not handledByMulti['Aimbot'] then
        pcall(function()
            if input.KeyCode == Enum.KeyCode[abKey:upper()] then
                local AB = shared.primidal['Aimbot']
                if not AB['Enabled'] then return end
                if AB['Mode'] == 'Hold' then
                    AB_TargetLocked = true
                    AB_Target = AB_GetClosestPlayer()
                else
                    AB_TargetLocked = not AB_TargetLocked
                    if AB_TargetLocked then
                        AB_Target = AB_GetClosestPlayer()
                    else
                        AB_Target = nil
                    end
                end
            end
        end)
    end

    local wsKey = binds['Walk Speed Toggle']
    if wsKey then
        pcall(function()
            if input.KeyCode == Enum.KeyCode[wsKey:upper()] then
                if shared.primidal['Character']['Movement']['Walk Speed']['Enabled'] then
                    MOV_SpeedActive = not MOV_SpeedActive
                    if not MOV_SpeedActive then
                        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass('Humanoid')
                        if hum then hum.WalkSpeed = 16 end
                    end
                end
            end
        end)
    end

    local jpKey = binds['Jump Power Toggle']
    if jpKey then
        pcall(function()
            if input.KeyCode == Enum.KeyCode[jpKey:upper()] then
                if shared.primidal['Character']['Movement']['Jump Power']['Enabled'] then
                    MOV_JumpActive = not MOV_JumpActive
                end
            end
        end)
    end

    local tbKey = binds['Triggerbot Toggle']
    local TB    = shared.primidal['Triggerbot']
    if TB['Enabled'] and not handledByMulti['Triggerbot'] then
        local act = TB['Activation']
        if act['Mode'] == 'Keybind' and tbKey then
            pcall(function()
                if input.KeyCode == Enum.KeyCode[tbKey:upper()] then
                    if act['Type'] == 'Toggle' then
                        TB_State = not TB_State
                    elseif act['Type'] == 'Hold' then
                        TB_State = true
                    end
                end
            end)
        elseif act['Mode'] == 'Mouse' then
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                if act['Type'] == 'Toggle' then
                    TB_State = not TB_State
                elseif act['Type'] == 'Hold' then
                    TB_State = true
                end
            end
        end
        if TB['Selection'] == 'Target' and tbKey then
            pcall(function()
                if input.KeyCode == Enum.KeyCode[tbKey:upper()] then
                    TB_TargetLocked = not TB_TargetLocked
                    if TB_TargetLocked then
                        TB_Target = SA_GetClosestPlayer()
                    else
                        TB_Target = nil
                    end
                end
            end)
        end
    end

    if input.KeyCode == Enum.KeyCode.LeftControl then
        TB_CanShoot = false
    end
    if sortKey then
        pcall(function()
            if input.KeyCode == Enum.KeyCode[sortKey:upper()] then
                local UTL = shared.primidal['Character']['Utilities']['Inventory Sorter']
                if not UTL['Enabled'] then return end
                task.spawn(function()
                    local char     = LocalPlayer.Character
                    local backpack = LocalPlayer:FindFirstChildOfClass('Backpack')
                    if not char or not backpack then return end
                    local order     = UTL['Order']
                    local orderSize = #order
                    local orderV    = 10 - orderSize

                    local temp = Instance.new('Folder')
                    temp.Name   = 'SorterTemp'
                    temp.Parent = workspace
                    for _, v in ipairs(backpack:GetChildren()) do
                        if v:IsA('Tool') then v.Parent = temp end
                    end

                    for _, name in ipairs(order) do
                        local gun = temp:FindFirstChild(name)
                        if gun then
                            gun.Parent = backpack
                            task.wait(0.05)
                        else
                            orderV = orderV + 1
                        end
                    end

                    for _, v in ipairs(temp:GetChildren()) do
                        if v:FindFirstChild('Drink') or v:FindFirstChild('Eat') then
                            v.Parent = backpack
                            orderV   = orderV - 1
                        end
                    end

                    if orderV > 0 then
                        for _ = 1, orderV do
                            local ph = Instance.new('Tool')
                            ph.Name            = ''
                            ph.ToolTip         = 'PlaceHolder'
                            ph.GripPos         = Vector3.new(0, 1, 0)
                            ph.RequiresHandle  = false
                            ph.Parent          = backpack
                        end
                    end

                    for _, v in ipairs(temp:GetChildren()) do
                        if v:IsA('Tool') then v.Parent = backpack end
                    end

                    for _, v in ipairs(backpack:GetChildren()) do
                        if v.Name == '' then v:Destroy() end
                    end

                    temp:Destroy()
                end)
            end
        end)
    end

    local armorKey = binds['Purchase Armor']
    if armorKey then
        pcall(function()
            if input.KeyCode == Enum.KeyCode[armorKey:upper()] then
                local UTL = shared.primidal['Character']['Utilities']['Purchase Armor']
                if not UTL['Enabled'] then return end
                local char = LocalPlayer.Character
                local hrp  = char and char:FindFirstChild('HumanoidRootPart')
                if not hrp then return end
                local ignored = workspace:FindFirstChild('Ignored')
                local shop    = ignored and ignored:FindFirstChild('Shop')
                if not shop then return end
                local armorShop  = nil
                local lowestPrice = math.huge
                for _, part in ipairs(shop:GetChildren()) do
                    local name = string.lower(part.Name)
                    if string.find(name, 'armor') then
                        local priceStr = string.match(name, '%$(%d+)')
                        local price    = priceStr and tonumber(priceStr) or math.huge
                        if price < lowestPrice then
                            local head     = part:FindFirstChild('Head')
                            local detector = part:FindFirstChildOfClass('ClickDetector')
                            if head and detector then
                                armorShop   = { head = head, detector = detector }
                                lowestPrice = price
                            end
                        end
                    end
                end
                if not armorShop then return end
                task.spawn(function()
                    local shopPos = armorShop.head.Position - Vector3.new(0, 8.8, 0)
                    local detector = armorShop.detector
                    for _ = 1, 60 do
                        if not hrp or not hrp.Parent then break end
                        pcall(fireclickdetector, detector)
                        local oldCF = hrp.CFrame
                        hrp.CFrame = CFrame.new(shopPos)
                        RunService.RenderStepped:Wait()
                        hrp.CFrame = oldCF
                        RunService.Heartbeat:Wait()
                    end
                end)
            end
        end)
    end
end)
