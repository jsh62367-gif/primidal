local function CreateLabel()
    local label = Instance.new("TextLabel")
    label.AnchorPoint            = Vector2.new(0.5, 0.5)
    label.BorderSizePixel        = 0
    label.BackgroundTransparency = 1
    label.RichText               = true
    label.Font                   = Enum.Font.SourceSansBold
    label.TextSize               = 13
    label.TextColor3             = Color3.new(1, 1, 1)
    label.Visible                = false
    label.Text                   = ""
    label.Size                   = UDim2.new(0, 300, 0, 20)
    label.Parent                 = UI

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Color     = Color3.new(0, 0, 0)
    stroke.Enabled   = true
    stroke.Parent    = label

    local obj = { label = label, _x = 0, _y = 0, _center = true }

    local function updatePos()
        local bounds  = label.TextBounds
        local offsetX = obj._center and 0 or (bounds.X / 2)
        label.Position = UDim2.fromOffset(obj._x + offsetX, obj._y + bounds.Y / 2)
    end

    function obj:SetText(t)    label.Text       = t end
    function obj:SetSize(s)    label.TextSize   = s end
    function obj:SetColor(c)   label.TextColor3 = c end
    function obj:SetVisible(v) label.Visible    = v end
    function obj:SetPos(x, y, center)
        self._x = x; self._y = y
        self._center = center ~= false
        updatePos()
    end
    function obj:Destroy() label:Destroy() end

    label:GetPropertyChangedSignal("TextBounds"):Connect(updatePos)
    return obj
end

